# =============================================================================
# Backend FastAPI — variables a renseigner dans N0C (Python App > Environment).
# A copier en .env (ne PAS committer .env).
# Remplace les valeurs <...> par celles que ton CTO te fournit.
# =============================================================================

# --- SendGrid ---
SENDGRID_API_KEY=<la nouvelle cle SendGrid (apres revocation de celle qui etait en .env.example)>
LNC_SENDGRID_TEMPLATE_ID=d-dd610c9721b54305bead1e7028eec11f
LNC_SENDGRID_FROM_EMAIL=contact@ogenies.com

# --- CORS : autorise le sous-domaine du front a appeler l'API ---
# Si ton front est sur https://mailing.ogeniesrgpd.com, mets-le ici (sans slash final).
LNC_CORS_ORIGINS=https://mailing.ogeniesrgpd.com

# --- Stockage des donnees : MySQL fourni par PlanetHoster ---
# Ces deux flags font lire prospects + events depuis MySQL (et non depuis les
# fichiers CSV/JSONL locaux). C'est le mode prod recommande.
LNC_EVENT_STORE=mysql
LNC_PROSPECT_SOURCE=mysql

LNC_MYSQL_HOST=<host MySQL, typiquement localhost sur N0C>
LNC_MYSQL_PORT=3306
LNC_MYSQL_USER=<utilisateur MySQL>
LNC_MYSQL_PASSWORD=<mot de passe MySQL>
LNC_MYSQL_DATABASE=<nom de la base>
LNC_MYSQL_PROSPECTS_TABLE=prospects
LNC_MYSQL_EVENTS_TABLE=email_events

# --- (Optionnel) generation OpenAI des emails ---
LNC_USE_OPENAI=false
LNC_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
